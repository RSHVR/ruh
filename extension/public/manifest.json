{
  "manifest_version": 3,
  "name": "Ruh",
  "version": "0.3.0",
  "description": "AI-powered product safety analysis - detect harmful substances and find safer alternatives",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.ca/*",
    "https://*.walmart.com/*",
    "https://*.costco.com/*",
    "https://*.instacart.com/*",
    "https://*.sephora.com/*",
    "https://*.hm.com/*",
    "https://*.uniqlo.com/*",
    "https://*.shein.com/*",
    "https://*.aritzia.com/*",
    "https://*.garageclothing.com/*",
    "https://*.ikea.com/*",
    "https://*.temu.com/*",
    "https://api.rshvr.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.rshvr.com https://*.supabase.co"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.ca/*",
        "https://*.walmart.com/*",
        "https://*.costco.com/*",
        "https://*.instacart.com/*",
        "https://*.sephora.com/*",
        "https://*.hm.com/*",
        "https://*.uniqlo.com/*",
        "https://*.shein.com/*",
        "https://*.aritzia.com/*",
        "https://*.garageclothing.com/*",
        "https://*.ikea.com/*",
        "https://*.temu.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Ruh - Product Safety"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
