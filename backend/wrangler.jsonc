{
  "name": "ruh-api",
  "main": "worker.js",
  "compatibility_date": "2025-05-06",
  "account_id": "c4cfa96234cadfe6831a05ff8cc0b817",
  "containers": [
    {
      "class_name": "RuhApi",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUH_API", "class_name": "RuhApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RuhApi"] }],
  "routes": [{ "pattern": "api.rshvr.com", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "chrome-extension://mjgicecpbfabjaebiaioaijelbepihcl,https://rshvr.com"
  },
  "observability": { "enabled": true }
}
